# ============================================================
# .env.example — iAmigo
# Copie para .env e preencha os dados reais.
# NUNCA commitar o .env real: o .gitignore já exclui .env* e o
# docker-compose.yml carrega .env apenas dentro do container.
# ============================================================

# ---------------------------------------------------------------------------
# Telegram (obrigatório, lido no import de api/client.py)
# Obtidos em @BotFather (token do bot) e @userinfobot (seu user ID)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_USER_ID=12345678

# ---------------------------------------------------------------------------
# Logging (opcional)
# INFO | WARNING | ERROR | CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Ollama (opcional) — acesso interno da compose: http://ollama:11434
# No Docker, NUNCA uses host.docker.internal (só funciona no Docker Desktop
# e exige --add-host=host.docker.internal:host-gateway no Linux).
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:3b
